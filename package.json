{
  "private": true,
  "version": "3.0.0",
  "scripts": {
    "prepare": "husky",
    "tag": "npm run tag:version && npm run tag:major && npm run tag:push",
    "tag:version": "git tag v$npm_package_version -f",
    "tag:major": "MAJOR=v${npm_package_version%%.*}; git tag -d $MAJOR 2>/dev/null; git push origin :refs/tags/$MAJOR 2>/dev/null; git tag $MAJOR v$npm_package_version -f",
    "tag:push": "git push origin --tags",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --max-warnings=0 --fix",
    "prebuild": "npm run lint",
    "build": "node .github/actions/stage-deploy/esbuild.config.js"
  },
  "devDependencies": {
    "@actions/core": "^3.0.1",
    "@panates/eslint-config": "^2.1.6",
    "ansi-colors": "^4.1.3",
    "esbuild": "^0.28.2",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "npm-check-updates": "^23.0.2",
    "yaml": "^2.9.0"
  }
}
